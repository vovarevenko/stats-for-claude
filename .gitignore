.DS_Store

.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
*.swp


# ──────────────────────────────────────────────────────────────
# Xcode — user-specific IDE state (never share these)
# ──────────────────────────────────────────────────────────────
xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint

# Xcode local workspace settings (machine-specific)
*.xcworkspace/xcuserdata/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
*.xcworkspace/xcshareddata/WorkspaceSettings.xcsettings

# Old Xcode 3/4 cruft
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.moved-aside

# ──────────────────────────────────────────────────────────────
# Swift Package Manager
# ──────────────────────────────────────────────────────────────
.build/
.swiftpm/xcode/

# NOTE: Package.resolved IS committed — it locks SPM dependency
# versions for reproducible builds.

# ──────────────────────────────────────────────────────────────
# xcodebuild local output
# ──────────────────────────────────────────────────────────────
build/
DerivedData/

# ──────────────────────────────────────────────────────────────
# Code coverage
# ──────────────────────────────────────────────────────────────
*.gcda
*.gcno

# ──────────────────────────────────────────────────────────────
# Misc tooling
# ──────────────────────────────────────────────────────────────
*.orig
*.rej
*~
